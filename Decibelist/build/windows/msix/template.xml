<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="decibelist.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Decibelist\Decibelist">
    </Installer>
    <PackageInformation
        PackageName="Decibelist"
        PackageDisplayName="Decibelist"
        PublisherName="CN=Decibelist"
        PublisherDisplayName="Decibelist"
        Version="0.1.0.0"
        PackageDescription="Offline AI Mastering">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.decibelist.app"
                Description="Offline AI Mastering"
                DisplayName="Decibelist"
                ExecutableName="decibelist.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Decibelist</DisplayName>
            <PublisherDisplayName>Decibelist</PublisherDisplayName>
            <Description>Offline AI Mastering</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="decibelist.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
